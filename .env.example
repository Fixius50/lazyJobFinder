# =============================================================================
# Plantilla de Variables de Entorno para lazyJobFinder
# =============================================================================
# Copia este archivo como '.env' y completa tus valores:
# cp .env.example .env

# -----------------------------------------------------------------------------
# 1. Configuración de Telegram (Interfaz Principal)
# -----------------------------------------------------------------------------
# Token del bot proporcionado por @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Tu ID numérico de usuario en Telegram (obtenlo hablando con @userinfobot)
# Solo este usuario tendrá permiso para consultar el estado y recibir documentos
TELEGRAM_ALLOWED_USER_ID=123456789

# -----------------------------------------------------------------------------
# 2. Configuración de Ollama (IA Local en Docker)
# -----------------------------------------------------------------------------
# URL de red interna en Docker hacia el contenedor de Ollama
OLLAMA_BASE_URL=http://ollama:11434

# Modelo recomendado por eficiencia en CPU y comprensión de español y programación:
# - qwen2.5:3b-instruct (Recomendado: ~2.0 GB de RAM, 30+ tok/s en CPU, formato JSON estricto)
# - qwen2.5:7b-instruct-q4_K_M (Opcional si dispones de 16 GB de RAM en el equipo: ~4.7 GB)
OLLAMA_MODEL=qwen2.5:3b-instruct

# -----------------------------------------------------------------------------
# 3. Planificación y Umbrales
# -----------------------------------------------------------------------------
# Hora y minuto del escaneo diario automático (formato 24h)
SCHEDULE_HOUR=08
SCHEDULE_MINUTE=30

# Puntuación mínima de afinidad (0 a 100) para generar documentos y notificar
MIN_SCORE_THRESHOLD=65

# -----------------------------------------------------------------------------
# 4. Credenciales Opcionales de Fuentes
# -----------------------------------------------------------------------------
# InfoJobs API (Opcional, gratuita en developer.infojobs.net)
# Si se dejan en blanco, el sistema utiliza Tecnoempleo RSS, Indeed, LinkedIn y Glassdoor
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# 5. Caché Centralizada de Python
# -----------------------------------------------------------------------------
# Agrupa los archivos de bytecode compilado (.pyc) en una única carpeta central
# evitando dispersión de carpetas __pycache__ por todo el repositorio.
PYTHONPYCACHEPREFIX=.cache/pycache

