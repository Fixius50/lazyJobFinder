# =============================================================================
# Variables de Entorno - lazyJobFinder
# =============================================================================
# Configura tus credenciales para las notificaciones y APIs externas.
# Este archivo no se envía a ningún servidor externo. Permanece 100% en tu equipo.

# Notificaciones por Telegram (Opcional)
# Crea tu bot hablando con @BotFather en Telegram y obtén tu ID con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Integración con API de InfoJobs (Opcional)
# Obtén tus claves en https://developer.infojobs.net/
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# Configuración interna del motor de IA
OLLAMA_BASE_URL=http://ollama:11434
DATABASE_PATH=/app/data/lazyjobfinder.db
