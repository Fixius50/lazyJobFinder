{
  "application_statuses": {
    "discovered": { "label": "Descubierta", "badge": "secondary" },
    "evaluated": { "label": "Evaluada", "badge": "outline" },
    "interview": { "label": "Entrevista", "badge": "success" },
    "discarded": { "label": "Descartada", "badge": "destructive" },
